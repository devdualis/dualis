PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dualis_dev
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DISCLAIMER_VERSION=2026.2
# Gemini on Vertex AI (no API key). Leave VERTEX_PROJECT empty to turn AI off.
# Credentials: service-account key below, or leave both empty to use Application
# Default Credentials (Cloud Run service account / `gcloud auth application-default login`).
# The service account needs roles/aiplatform.user.
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=southamerica-east1
VERTEX_CLIENT_EMAIL=
VERTEX_PRIVATE_KEY=


# Email via Resend (https://resend.com). Leave RESEND_API_KEY empty to log codes
# to the console instead (simulation, never in production). MAIL_FROM must use a
# domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="DualisCheckUp <nao-responda@dualischeckup.com>"

# Supabase Storage & Services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_AVATAR_BUCKET=avatars

# Oldest app version allowed to use the API (older builds show an update screen)
MIN_SUPPORTED_APP_VERSION=1.0.0

# Google Cloud Vision (exam and prescription reading, premium)
GOOGLE_VISION_API_KEY=
