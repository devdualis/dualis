PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dualis_dev
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DISCLAIMER_VERSION=2026.2
# Gemini on Vertex AI (no API key). Auth = Application Default Credentials:
# locally `gcloud auth application-default login`; on Cloud Run the service account
# needs roles/aiplatform.user. Leave the project empty to turn AI off.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=southamerica-east1


# Email / SMTP
SMTP_HOST=smtp-pulse.com
SMTP_PORT=587
SMTP_USER=dev@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="DualisCheckUp <dev@example.com>"

# Supabase Storage & Services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_AVATAR_BUCKET=avatars

# Oldest app version allowed to use the API (older builds show an update screen)
MIN_SUPPORTED_APP_VERSION=1.0.0
