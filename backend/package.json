{
  "name": "dualis-backend",
  "version": "1.0.0",
  "description": "DualisCheckUp NestJS Fastify Backend Platform",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:coverage": "vitest run --coverage test/unit",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:rls": "vitest run --config ./vitest.config.security.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test:battery": "tsx scripts/run-agent-battery.ts",
    "verify:phase1": "npm run test && npm run test:rls && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@google/genai": "^2.32.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "~11.0.2",
    "@nestjs/passport": "~11.0.5",
    "@nestjs/platform-fastify": "^11.2.11",
    "@supabase/supabase-js": "^2.119.2",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.40.1",
    "fastify": "^5.12.8",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "~4.0.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "~3.0.13",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.30.6",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
